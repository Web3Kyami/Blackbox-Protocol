# Optional local web server port.
BLACKBOX_PORT=4173

# Optional RPC override for the read-only Mainnet readiness check.
BLACKBOX_MAINNET_RPC=https://rpc.starknet.lava.build

# Required only for the local STRK20 integration test.
# Point this to a prepared checkout of starkware-libs/starknet-privacy.
BLACKBOX_PRIVACY_REPO=/absolute/path/to/starknet-privacy

# BlackBox never reads private keys, seed phrases, or viewing keys from this file.
